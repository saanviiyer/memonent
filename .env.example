# Copy this file to .env and fill in what you need. memonent runs FULLY with none of
# these set. With no key the server runs in MOCK MODE, and every AI feature (digests,
# group labels, bullet-to-prose) returns a realistic result built from your own notes.

# --- AI (server-side only; never shipped to the browser) -------------------
# If unset, the server runs in MOCK MODE.
ANTHROPIC_API_KEY=

# Optional: override the server port (default 3001)
PORT=3001
